{
  "manifest_version": 3,
  "name": "Art Institute of Chicago: Art Tab - Enhanced",
  "version": "2.1.1",
  "action": {
    "default_icon": {
      "16": "assets/logo--icon--16.png",
      "48": "assets/logo--icon--48.png",
      "128": "assets/logo--icon--128.png"
    },
    "default_title": "Art Institute of Chicago",
    "default_popup": "options.html"
  },
  "description": "See a new, random artwork from the museum's vast collection every day (or every time you open a new tab.)",
  "icons": {
    "16": "assets/logo--icon--16.png",
    "48": "assets/logo--icon--48.png",
    "128": "assets/logo--icon--128.png"
  },
  "author": "Chris de Almeida",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.artic.edu/*"
  ],
  "optional_host_permissions": [
    "https://www.artic.edu/*",
    "https://artic.edu/*"
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "{30461fac-56ff-4058-b23b-d020b6be46c1}",
      "strict_min_version": "121.0"
    }
  }
}
